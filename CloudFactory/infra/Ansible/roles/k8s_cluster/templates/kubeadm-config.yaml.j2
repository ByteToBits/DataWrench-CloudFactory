# Managed by Ansible (roles/k8s_cluster). Used once, by `kubeadm init` on {{ k8s_cluster_first_control_plane }}.
# After init the cluster keeps its own copy (kubectl -n kube-system get cm kubeadm-config); editing this file changes nothing.
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: {{ ansible_host }}
  bindPort: 6443
nodeRegistration:
  name: {{ inventory_hostname }}
  criSocket: {{ k8s_cluster_cri_socket }}
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
clusterName: {{ k8s_cluster_name }}
kubernetesVersion: {{ k8s_cluster_kubeadm_version.stdout }}
controlPlaneEndpoint: "{{ k8s_cluster_api_name }}:{{ k8s_cluster_api_port }}"
networking:
  podSubnet: {{ k8s_cluster_pod_subnet }}
  serviceSubnet: {{ k8s_cluster_service_subnet }}
  dnsDomain: cluster.local
apiServer:
  certSANs:
    - {{ k8s_cluster_api_name }}
    - {{ k8s_cluster_api_vip }}
controllerManager:
  extraArgs:
    - name: node-cidr-mask-size-ipv4
      value: "{{ k8s_cluster_node_cidr_mask }}"
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
